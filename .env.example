# JLS Radar — varijable okruženja
# Kopiraj u .env.local i popuni vrijednostima iz Supabase projekta (Settings → API).

# Supabase (javno, sigurno za preglednik)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role (SAMO server / GitHub Actions ingestion — NIKADA u pregledniku!)
SUPABASE_SERVICE_ROLE_KEY=
